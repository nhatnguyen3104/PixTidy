<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.GeneralApps" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <!-- Theme for Splash Screen system -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F8F9FF</item>

        <!-- Use transparent icon so the system splash is just a background color.
             This allows a seamless transition to the Compose SplashScreen which
             shows the logo and progress bar. -->
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>

        <item name="postSplashScreenTheme">@style/Theme.GeneralApps</item>
    </style>
</resources>